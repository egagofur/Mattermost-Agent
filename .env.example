# ==============================================================================
# Mattermost Personal Account Automation Configuration
# ==============================================================================

# Mattermost Base URL (Required)
MATTERMOST_URL=https://mattermost.example.com

# ------------------------------------------------------------------------------
# 🌟 Primary Provider: Playwright Browser Automation (Recommended & Default)
# ------------------------------------------------------------------------------
# Playwright is the primary provider because regular non-admin corporate users
# cannot generate Personal Access Tokens (PAT) or create incoming webhooks.
# With Playwright, any team member can log in once (supporting SSO/MFA) via:
#   npm run cli -- login
# The session is securely saved locally and reused automatically in headless mode.
MATTERMOST_PROVIDER=playwright

# Directory for storing the persistent browser session profile (gitignored)
MATTERMOST_BROWSER_PROFILE_DIR=./data/mattermost-browser

# Set to false if you want to observe browser actions visually during automation
MATTERMOST_HEADLESS=true

# ------------------------------------------------------------------------------
# ⚡ Alternative Provider: REST API v4 (For users with Personal Access Tokens)
# ------------------------------------------------------------------------------
# Set MATTERMOST_PROVIDER=api if your Mattermost server allows creating PATs under:
#   Settings -> Security -> Personal Access Tokens
# MATTERMOST_TOKEN=your_personal_access_token_here

# ------------------------------------------------------------------------------
# 📁 Channel Mapping & Environment Overlays
# ------------------------------------------------------------------------------
# Path to custom YAML channels mapping file (auto-detected if ./channels.yml exists)
MATTERMOST_CHANNELS_CONFIG=./channels.yml

# Active environment overlay for channels.yml (e.g. dev, staging, prod)
MATTERMOST_ENV=dev

# ------------------------------------------------------------------------------
# 🏢 Team & Identity Verification Context (Optional)
# ------------------------------------------------------------------------------
# Default team ID or slug
MATTERMOST_TEAM_ID=
MATTERMOST_TEAM_NAME=

# Identity lock (Fail-fast check to prevent running under an unexpected account)
MATTERMOST_EXPECTED_USER_ID=
MATTERMOST_EXPECTED_USERNAME=

# ------------------------------------------------------------------------------
# 📝 Observability
# ------------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info
